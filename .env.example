# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Analytics is disabled when unset.
VITE_GA_MEASUREMENT_ID=

# First-party GA4 event collector — Apps Script Web App /exec URL.
# On mobile the site posts events here (relayed to GA4 server-side) instead of
# loading gtag.js, which the Instagram/Facebook in-app browsers often block.
# The collector lives in the booking Apps Script (action: 'collect'), so this
# defaults to VITE_BACKEND_URL when unset — only set it to split them onto a
# separate Web App. See apps-script/Analytics.gs.
VITE_ANALYTICS_URL=

# Google Apps Script Web App /exec URL for the in-site booking flow
# (availability + booking + live reviews). See apps-script/README.md.
# When unset the /book page shows the call/Studio24 fallback instead.
VITE_BACKEND_URL=
