# Build mode: "static" (GitHub Pages, no backend) or "integrated" (served by backend)
# Default is "static" — only set to "integrated" when building via `npm run build:integrated`
VITE_DEPLOY_MODE=static

# Backend API base URL.
# In dev it defaults to http://localhost:3001 even without this var.
# In integrated mode it defaults to "" (same-origin relative paths).
# In static mode it defaults to null (API disabled, bundled fallback only).
VITE_API_URL=http://localhost:3001

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Analytics is disabled when unset.
VITE_GA_MEASUREMENT_ID=
