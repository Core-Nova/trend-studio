{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "build:integrated": "cross-env VITE_DEPLOY_MODE=integrated vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "fetch-reviews": "node backend/scripts/fetch-reviews.mjs",
    "fetch-reviews:override": "node backend/scripts/fetch-reviews.mjs --override"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.7.0",
    "lint-staged": "^16.3.1",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "svgo": "^3.3.2",
    "terser": "^5.46.0",
    "vite": "^7.2.4",
    "vite-imagetools": "^10.0.0",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vitest": "^4.0.18"
  }
}
