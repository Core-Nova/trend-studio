# Google Places API
# Get a key at https://console.cloud.google.com — enable "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Place ID for the salon
# Look it up at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Instagram Graph API
# Generate a long-lived token via the Instagram Basic Display API
# https://developers.facebook.com/docs/instagram-basic-display-api/guides/long-lived-access-tokens
INSTAGRAM_ACCESS_TOKEN=

# Server
PORT=3001
# Allowed origin(s) for CORS, comma-separated.
# In integrated mode (backend serves frontend) this is irrelevant — same origin.
# Default is * (open). Lock down in production if needed.
CORS_ORIGIN=*

# Rate limiting (requests per minute per IP)
RATE_LIMIT_API_MAX=60
RATE_LIMIT_IMAGES_MAX=300
