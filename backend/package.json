{
  "name": "trend-studio-backend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Backend API server for TREND Hair Boutique Studio",
  "scripts": {
    "fetch-reviews": "node scripts/fetch-reviews.mjs",
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build:frontend": "cd .. && npm run build:integrated",
    "start:full": "npm run build:frontend && node server/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "morgan": "^1.10.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
